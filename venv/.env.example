# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Image agent model (image models need a paid / billing-enabled API key)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# MySQL database used by the DB agent
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# RAG: comma-separated tables to index (empty = all tables)
RAG_TABLES=
RAG_TOP_K=8
RAG_MAX_ROWS_PER_TABLE=50000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant vector DB
# Leave QDRANT_URL empty to use local on-disk Qdrant (data/qdrant_db)
# Docker:        QDRANT_URL=http://localhost:6333
# Qdrant Cloud:  QDRANT_URL=https://<cluster>.cloud.qdrant.io  (+ QDRANT_API_KEY)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# DB agent: true = SQL + vector search, false = SQL only
DB_USE_VECTOR_SEARCH=true
